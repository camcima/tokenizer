{
  "providers": {
    "stripe": {
      "format": "form",
      "endpoints": [
        {
          "id": "payment_methods",
          "method": "POST",
          "path": "/v1/payment_methods",
          "card_data": true,
          "headers": {
            "Authorization": "Bearer {{secret:secretKey}}"
          },
          "positions": {
            "card[number]": "{{pan}}",
            "card[exp_month]": "{{exp_month}}",
            "card[exp_year]": "{{exp_year}}",
            "card[cvc]": "{{cvv}}",
            "billing_details[name]": "{{name}}"
          },
          "forbid": {
            "customer": [],
            "payment_method": [],
            "allow_redisplay": [],
            "setup_future_usage": []
          }
        },
        {
          "id": "tokens",
          "method": "POST",
          "path": "/v1/tokens",
          "card_data": true,
          "headers": {
            "Authorization": "Bearer {{secret:secretKey}}"
          },
          "positions": {
            "card[number]": "{{pan}}",
            "card[exp_month]": "{{exp_month}}",
            "card[exp_year]": "{{exp_year}}",
            "card[cvc]": "{{cvv}}",
            "card[name]": "{{name}}"
          }
        }
      ]
    }
  },
  "accounts": {
    "stripe_test": {
      "provider": "stripe",
      "env": "dev",
      "host": "api.stripe.com",
      "base_path": "",
      "secrets": {
        "secretKey": "projects/pci-cde-dev/secrets/stripe-test-secret-key"
      },
      "values": {}
    }
  }
}
